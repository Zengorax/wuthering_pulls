<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#0b0e13">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
        <title>{% block title %}Wuthering Pulls{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="min-h-screen antialiased">
        <header class="site-header">
            <a class="brand" href="{{ path('dashboard') }}">
                <span class="brand-mark">W</span>
                <span>Wuthering <span class="brand-muted">Pulls</span></span>
            </a>
            <span class="header-caption">Votre historique d’invocations</span>
        </header>
        {% for label, messages in app.flashes %}
            <div class="flash-stack" role="status">
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            </div>
        {% endfor %}
        <main class="page-shell">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
