{% extends 'base.html.twig' %}

{% import '_macros.html.twig' as ui %}

{% block title %}{{ 'dashboard.title'|trans }} · Wuthering Pulls{% endblock %}

{% block body %}
    {% set pity_soft = constant('App\\Statistics\\PullRules::SOFT_PITY') %}
    {% set expected = dashboard.expectedPulls %}

    {# ============ HERO ============ #}
    <section class="hero" data-controller="reveal resonator">
        <div class="hero__copy reveal">
            <span class="eyebrow">{{ 'hero.eyebrow'|trans }}</span>
            <h1 class="glitch" data-text="{{ 'hero.title'|trans }}">{{ 'hero.title'|trans }}</h1>
            <p class="lead">{{ 'hero.lead'|trans }}</p>
            <div class="hero__actions">
                {% if dashboard.hasVersions %}
                    <a class="btn btn--primary" href="#entry">{{ 'hero.cta_record'|trans }}</a>
                {% else %}
                    <a class="btn btn--primary" href="{{ path('major_version_new') }}">{{ 'hero.cta_start'|trans }}</a>
                {% endif %}
                {% if dashboard.periods is not empty %}
                    <a class="btn btn--ghost" href="{{ path('version_new') }}">{{ ui.icon('plus', 'icon icon--sm') }}{{ 'action.add_version'|trans }}</a>
                {% endif %}
            </div>
        </div>

        <div class="resonator reveal" style="--i:2" aria-hidden="true" data-resonator-target="stage">
            {# Calques empilés : chaque anneau tourne comme un bloc (transformation accélérée par le GPU). #}
            <div class="resonator__layer" data-resonator-target="layerFar">
                <svg viewBox="0 0 400 400" class="spin spin--slow"><circle class="ring ring--ticks" cx="200" cy="200" r="190"/></svg>
                <svg viewBox="0 0 400 400" class="spin spin--reverse"><circle class="ring ring--dash" cx="200" cy="200" r="172"/></svg>
            </div>
            <div class="resonator__layer" data-resonator-target="layerMid">
                <svg viewBox="0 0 400 400" class="spin"><circle class="ring ring--arc" cx="200" cy="200" r="150"/></svg>
                <svg viewBox="0 0 400 400">
                    <polygon class="resonator__diamond" points="200,46 354,200 200,354 46,200"/>
                    <polygon class="resonator__diamond resonator__diamond--inner" points="200,92 308,200 200,308 92,200"/>
                    <path class="resonator__mark" d="M200 8v14M200 378v14M8 200h14M378 200h14"/>
                </svg>
            </div>
            <i class="resonator__pulse"></i><i class="resonator__pulse"></i><i class="resonator__pulse"></i>
            <svg viewBox="0 0 400 400" class="resonator__wavebox"><path class="resonator__wave" data-resonator-target="wave" d="M 112 318 L 288 318"/></svg>
            <div class="resonator__core">
                <div class="resonator__count" data-controller="counter" data-counter-to-value="{{ dashboard.totalPulls }}">{{ dashboard.totalPulls|number_format(0, ',', ' ') }}</div>
                <div class="resonator__label">{{ 'hero.convenes'|trans }}</div>
                <div class="resonator__sub">≈ <span data-controller="counter" data-counter-to-value="{{ dashboard.totalAstrites }}" data-testid="total-astrites">{{ dashboard.totalAstrites|number_format(0, ',', ' ') }}</span> {{ 'unit.astrites_short'|trans }}</div>
            </div>
        </div>
    </section>

    {# ============ STATISTIQUES ============ #}
    <section id="stats" class="stats" aria-label="{{ 'stats.aria'|trans }}" data-controller="reveal">
        <article class="stat panel panel--hud reveal" style="--i:0">
            <h2 class="stat__k">{{ 'stats.character_avg'|trans }}</h2>
            <p class="stat__v" data-testid="avg-character">
                {% if dashboard.characterAverage is not null %}
                    <span data-controller="counter" data-counter-to-value="{{ dashboard.characterAverage|round(1) }}" data-counter-decimals-value="1">{{ dashboard.characterAverage|number_format(1, ',', ' ') }}</span>
                {% else %}—{% endif %}
                <small>{{ 'unit.pulls'|trans }}</small>
            </p>
            <p class="stat__h" data-testid="avg-character-hint">{{ 'stats.counted_targets'|trans({count: dashboard.characterCount}) }}</p>
            {% if dashboard.luckPercent is not null %}
                <p class="stat__luck {{ dashboard.luckPercent >= 0 ? 'is-good' : 'is-bad' }}" data-testid="luck">
                    {{ dashboard.luckPercent >= 0 ? '▲' : '▼' }}
                    {{ (dashboard.luckPercent >= 0 ? '+' : '−') ~ (dashboard.luckPercent|abs|round)|number_format(0, ',', ' ') }} % {{ 'stats.vs_expected'|trans({expected: expected|round}) }}
                </p>
            {% endif %}
            <div class="gauge" aria-hidden="true">
                <i style="--w:{{ dashboard.characterAverage is not null ? min(100, dashboard.characterAverage / 160 * 100)|round(1) : 0 }}%"></i>
                <b style="--x:{{ (expected / 160 * 100)|round(1) }}%"></b>
            </div>
        </article>

        <article class="stat panel panel--hud reveal" style="--i:1">
            <h2 class="stat__k">{{ 'stats.weapon_avg'|trans }}</h2>
            <p class="stat__v" data-testid="avg-weapon">
                {% if dashboard.weaponAverage is not null %}
                    <span data-controller="counter" data-counter-to-value="{{ dashboard.weaponAverage|round(1) }}" data-counter-decimals-value="1">{{ dashboard.weaponAverage|number_format(1, ',', ' ') }}</span>
                {% else %}—{% endif %}
                <small>{{ 'unit.pulls'|trans }}</small>
            </p>
            <p class="stat__h">{{ 'stats.counted_weapons'|trans({count: dashboard.weaponCount}) }}</p>
            <div class="gauge" aria-hidden="true">
                <i style="--w:{{ dashboard.weaponAverage is not null ? min(100, dashboard.weaponAverage / 80 * 100)|round(1) : 0 }}%"></i>
                <b style="--x:{{ (pity_soft / 80 * 100)|round(1) }}%"></b>
            </div>
        </article>

        <article class="stat stat--gold panel panel--hud reveal" style="--i:2">
            <h2 class="stat__k">{{ 'stats.fifty_fifty'|trans }}</h2>
            {% set rate = dashboard.fiftyFiftyRate %}
            <div class="donut" data-testid="fifty-fifty" data-rate="{{ rate ?? '' }}">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="donut__track" cx="60" cy="60" r="48"/>
                    <circle class="donut__value" cx="60" cy="60" r="48" pathLength="100" style="--v:{{ rate ?? 0 }}"/>
                </svg>
                <div class="donut__center">
                    <strong>{{ rate is not null ? rate ~ ' %' : '—' }}</strong>
                    <span>{{ 'stats.won_lost'|trans({won: dashboard.fiftyFiftyWon, lost: dashboard.fiftyFiftyLost}) }}</span>
                </div>
            </div>
            <p class="stat__h">{{ 'stats.fifty_hint'|trans }}</p>
        </article>

        <article class="stat panel panel--hud reveal" style="--i:3">
            <h2 class="stat__k">{{ 'stats.real_vs_estimate'|trans }}</h2>
            <p class="stat__v"><span data-controller="counter" data-counter-to-value="{{ dashboard.realPulls }}">{{ dashboard.realPulls|number_format(0, ',', ' ') }}</span> <small>{{ 'stats.real'|trans }}</small></p>
            <p class="stat__h" data-testid="estimated-pulls">+ {{ dashboard.estimatedPulls|number_format(0, ',', ' ') }} {{ 'stats.estimated'|trans }} ({{ dashboard.estimatedShare }} %)</p>
            <div class="split" aria-hidden="true"><i style="--w:{{ 100 - dashboard.estimatedShare }}%"></i><b style="--w:{{ dashboard.estimatedShare }}%"></b></div>
        </article>
    </section>

    {# ============ ANALYSE ============ #}
    {% if dashboard.hasVersions %}
        <section class="analysis" data-controller="reveal">
            <div class="analysis__chart reveal">
                <div class="section-title"><span class="section-title__idx">I</span><h2>{{ 'chart.title'|trans }}</h2></div>
                <div class="frame frame--cut">
                    <div class="panel panel--hud chart" data-controller="chart" data-chart-data-value="{{ dashboard.chart|merge({distribution: dashboard.distribution})|json_encode|e('html_attr') }}" data-chart-labels-value="{{ {total: 'chart.tab.total'|trans, split: 'chart.tab.split'|trans, cumulative: 'chart.tab.cumulative'|trans, distribution: 'chart.tab.distribution'|trans, character: 'chart.character'|trans, weapon: 'chart.weapon'|trans, pulls: 'unit.pulls'|trans, targets: 'chart.targets'|trans, estimated: 'stats.estimated'|trans}|json_encode|e('html_attr') }}">
                        <div class="chart__head">
                            <span class="eyebrow" data-chart-target="caption"></span>
                            <div class="tabs" role="tablist" aria-label="{{ 'chart.modes'|trans }}">
                                {% for mode in ['total', 'split', 'cumulative', 'distribution'] %}
                                    <button type="button" role="tab" class="tab" data-chart-target="tab" data-action="chart#select" data-chart-mode-param="{{ mode }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ ('chart.tab.' ~ mode)|trans }}</button>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="chart__stage">
                            <svg class="chart__svg" data-chart-target="svg" role="img" aria-label="{{ 'chart.title'|trans }}"></svg>
                            <div class="chart__tip" data-chart-target="tip" role="presentation"></div>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="analysis__side reveal" style="--i:2">
                <div class="section-title"><span class="section-title__idx">II</span><h2>{{ 'projection.title'|trans }}</h2></div>
                <div class="frame frame--gold">
                    <div class="panel panel--hud projection" data-testid="projection">
                        {% if dashboard.projection is not null %}
                            {% set p = dashboard.projection %}
                            <p class="muted">{{ 'projection.from'|trans({version: p.fromVersion}) }}</p>
                            <p class="projection__big"><span data-controller="counter" data-counter-to-value="{{ p.projectedPulls|round }}">{{ p.projectedPulls|round|number_format(0, ',', ' ') }}</span> <small>{{ 'unit.pulls'|trans }}</small></p>
                            <dl class="projection__list">
                                <div><dt>{{ 'projection.start'|trans }}</dt><dd>{{ p.startPulls|round|number_format(0, ',', ' ') }}</dd></div>
                                <div><dt>{{ 'projection.income'|trans }}</dt><dd>{{ p.averageIncome >= 0 ? '+' : '−' }}{{ p.averageIncome|abs|round|number_format(0, ',', ' ') }}</dd></div>
                                <div><dt>{{ 'projection.guaranteed'|trans }}</dt><dd>{{ p.guaranteedFeatured }}</dd></div>
                                <div><dt>{{ 'projection.expected'|trans }}</dt><dd>≈ {{ p.expectedFeatured|number_format(1, ',', ' ') }}</dd></div>
                            </dl>
                            <p class="projection__note">{{ 'projection.note'|trans }}</p>
                        {% else %}
                            <p class="muted">{{ 'projection.empty'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </aside>
        </section>
    {% endif %}

    {# ============ HISTORIQUE + SAISIE ============ #}
    <div class="workspace" data-controller="reveal">
        <section id="history" class="history" aria-label="{{ 'history.aria'|trans }}">
            <div class="section-title reveal"><span class="section-title__idx">III</span><h2>{{ 'history.title'|trans }}</h2></div>

            {% for summary in dashboard.periods %}
                {% include 'dashboard/_period.html.twig' with {summary: summary, index: loop.index0} only %}
            {% else %}
                <div class="empty reveal">
                    <strong>{{ 'empty.title'|trans }}</strong>
                    <p>{{ 'empty.text'|trans }}</p>
                    <a class="btn btn--primary" href="{{ path('major_version_new') }}">{{ 'empty.cta'|trans }}</a>
                </div>
            {% endfor %}
        </section>

        <aside id="entry" class="entry reveal" style="--i:2">
            <div class="frame frame--gold">
                <div class="panel panel--hud">
                    <span class="eyebrow">{{ 'entry.eyebrow'|trans }}</span>
                    <h2 class="entry__title">{{ 'entry.title'|trans }}</h2>
                    <p class="muted">{{ 'entry.description'|trans }}</p>

                    {% if dashboard.hasVersions %}
                        {{ form_start(target_form, {attr: {class: 'form-stack', novalidate: 'novalidate', 'data-testid': 'target-form'}}) }}
                            {{ form_errors(target_form) }}
                            {{ form_row(target_form.version) }}
                            {{ form_row(target_form.name) }}
                            <div class="field-pair">
                                {{ form_row(target_form.rarity) }}
                                {{ form_row(target_form.element) }}
                            </div>
                            <div class="field-pair">
                                {{ form_row(target_form.pullsCharacter) }}
                                {{ form_row(target_form.pullsWeapon) }}
                            </div>
                            {{ form_row(target_form.fiftyFiftyResult) }}
                            {{ form_row(target_form.isEstimate) }}
                            {{ form_row(target_form.notes) }}
                            <button class="btn btn--primary btn--block" type="submit">{{ 'entry.submit'|trans }}</button>
                        {{ form_end(target_form) }}
                    {% else %}
                        <p class="muted">{{ 'entry.need_version'|trans }}</p>
                        {% if dashboard.periods is empty %}
                            <a class="btn btn--primary btn--block" href="{{ path('major_version_new') }}">{{ 'empty.cta'|trans }}</a>
                        {% else %}
                            <a class="btn btn--primary btn--block" href="{{ path('version_new') }}">{{ 'action.add_version'|trans }}</a>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </aside>
    </div>
{% endblock %}
