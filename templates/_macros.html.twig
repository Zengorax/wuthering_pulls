{# Icônes SVG en ligne : une seule source pour tout le site. #}
{% macro icon(name, class = 'icon') %}
    <svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'edit' %}<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/>
        {% elseif name == 'trash' %}<path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13M10 11v6M14 11v6"/>
        {% elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
        {% elseif name == 'chevron' %}<path d="M6 9l6 6 6-6"/>
        {% elseif name == 'sliders' %}<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
        {% elseif name == 'calendar' %}<rect x="4" y="5" width="16" height="15" rx="1"/><path d="M4 10h16M9 3v4M15 3v4"/>
        {% elseif name == 'close' %}<path d="M6 6l12 12M18 6L6 18"/>
        {% elseif name == 'star' %}<path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.5 6.6L12 17.2 6 20.5l1.5-6.6-5-4.5 6.6-.7z" fill="currentColor" stroke="none"/>
        {% elseif name == 'spark' %}<path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z"/>
        {% endif %}
    </svg>
{% endmacro %}

{# Bouton de suppression POST protégé par un jeton CSRF et une confirmation Turbo. #}
{% macro delete_form(action, token_id, confirm, label) %}
    {% import _self as ui %}
    <form method="post" action="{{ action }}" data-turbo-confirm="{{ confirm }}" data-turbo-frame="_top" class="inline-form">
        <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
        <button type="submit" class="icon-btn danger" title="{{ label }}" aria-label="{{ label }}">{{ ui.icon('trash') }}</button>
    </form>
{% endmacro %}
